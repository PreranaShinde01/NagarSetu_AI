{
  "name": "nagarsetu-ai",
  "version": "1.0.0",
  "description": "NagarSetu AI - Smart City Governance and Public Accountability Platform",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/src/server.js",
    "seed": "node server/src/seed/seed.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"cross-env WAIT_ON_WEB=true wait-on http://localhost:5173 && electron .\"",
    "start": "concurrently \"vite\" \"node server/src/server.js\" \"electron .\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
